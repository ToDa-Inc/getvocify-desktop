<Window x:Class="VocifyCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vocify Companion"
        Height="720" Width="460"
        Background="#F7F4EE">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vocify" />
      <TextBlock Foreground="#666" Text="Companion" />
    </StackPanel>
    <StackPanel>
      <TextBlock FontSize="28" Text="Entra para escuchar" Margin="0,0,0,8" />
      <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12"
                 Text="La misma cuenta que el dashboard. El audio del sistema es el otro. El micrófono eres tú." />
      <TextBox x:Name="Email" Margin="0,0,0,8" />
      <PasswordBox x:Name="Password" Margin="0,0,0,8" />
      <TextBox x:Name="ApiBase" Text="https://api.getvocify.com/api/v1" Margin="0,0,0,8" />
      <Button Content="Entrar" Click="Login_Click" Padding="12,6" HorizontalAlignment="Left" />
      <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap" />
      <TextBlock Margin="0,16,0,4" Text="Transcripción" />
      <TextBox x:Name="Transcript" AcceptsReturn="True" Height="180" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="Escuchar" Click="Listen_Click" Padding="12,6" Margin="0,0,8,0" />
        <Button Content="Parar y enviar" Click="Stop_Click" Padding="12,6" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
